
export ZSH="$HOME/.oh-my-zsh"

plugins=(git)

source $HOME/.aliases
source $HOME/.zshenv
source $ZSH/oh-my-zsh.sh

export NVM_DIR="$HOME/.nvm"

[ -s "$NVM_DIR/nvm.sh" ] && . "$NVM_DIR/nvm.sh"

# Set Spaceship ZSH as a prompt
autoload -U promptinit; promptinit
prompt spaceship

if command -v pyenv 1>/dev/null 2>&1; then
  eval "$(pyenv init --path)"
fi

export PATH="$HOME/.poetry/bin:$PATH"
export PATH="/usr/local/opt/openjdk@11/bin:$PATH"
export PATH="/usr/local/opt/openjdk@8/bin:$PATH"
export ANDROID_SDK_ROOT="$HOME/Library/Android/sdk"
export PATH=$ANDROID_SDK/emulator:$ANDROID_SDK/tools:$ANDROID_SDK/platform-tools:$PATH
#OktaAWSCLI
if [[ -f "$HOME/.okta/bash_functions" ]]; then
    . "$HOME/.okta/bash_functions"
fi
if [[ -d "$HOME/.okta/bin" && ":$PATH:" != *":$HOME/.okta/bin:"* ]]; then
    PATH="$HOME/.okta/bin:$PATH"
fi

[[ -s "/Users/timothyholmes/.gvm/scripts/gvm" ]] && source "/Users/timothyholmes/.gvm/scripts/gvm"

ssh_box () {
    REPLACE_SHORTNAME=$1
    REPLACE_LANG=$2
    command ssh -A -i ~/.ssh/tholmes.pem luminate@$REPLACE_LANG.$REPLACE_SHORTNAME.use1.amz.mtmetest.com@dev-ssh-gateway-devstack@dev-ssh-gateway-devstack.ssh.tmg.luminatesec.com
}

export PATH="/usr/local/sbin:$PATH"

eval "$(/opt/homebrew/bin/brew shellenv)"

export PATH="$HOME/.local/bin:$PATH"
